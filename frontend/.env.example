# SuratRojgar frontend (Next.js). Copy to .env.local / .env.production. Never commit real env files.
# Public site URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://suratrojgar.in
# Public origin of the Laravel API (used only for images such as logos/sliders)
NEXT_PUBLIC_API_ORIGIN=https://api.suratrojgar.in
# Internal URL the Next.js server uses to reach the Laravel API (same VPS: loopback, no public hop)
API_INTERNAL_URL=http://127.0.0.1:8000/api/v1
# Set to "true" in production so the session cookie is only sent over HTTPS
COOKIE_SECURE=true

# Set to true ONLY on the live production domain, so staging/test copies are never indexed by Google
ALLOW_INDEXING=false

# Shared secret between the Next.js server and the API (same value in backend .env). Generate: openssl rand -hex 32
INTERNAL_API_KEY=
