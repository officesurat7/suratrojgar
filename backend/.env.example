# ------------------------------------------------------------------
# SuratRojgar API - environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------
APP_NAME=SuratRojgar
APP_ENV=production          # local | staging | production
APP_KEY=                    # php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.suratrojgar.in
APP_TIMEZONE=UTC            # keep UTC; display timezone is DISPLAY_TIMEZONE
DISPLAY_TIMEZONE=Asia/Kolkata
FRONTEND_URL=https://suratrojgar.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# Comma separated IPs of reverse proxies / Next.js server allowed to set X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1
# Shared secret sent by the Next.js server on server-side reads (same value in frontend env). Generate: openssl rand -hex 32
INTERNAL_API_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=suratrojgar
DB_USERNAME=suratrojgar
DB_PASSWORD=
# Optional read replica (leave empty to use the primary for reads)
DB_READ_HOST=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=sr_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@suratrojgar.in"
MAIL_FROM_NAME="SuratRojgar"

# Sanctum token lifetimes (minutes)
TOKEN_TTL_USER=10080
TOKEN_TTL_ADMIN=720

# Optional ClamAV daemon socket for resume malware scanning (leave empty to skip)
CLAMAV_SOCKET=

# Database backups
BACKUP_PATH=/var/backups/suratrojgar
BACKUP_RETENTION_DAYS=14
